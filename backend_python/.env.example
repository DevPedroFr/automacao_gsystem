# App Settings
APP_NAME="Automação GP API"
DEBUG=True
PORT=8000

# Database & Async Queues
DATABASE_URL=postgresql://user:password@localhost:5432/automacao_gp
REDIS_URL=redis://localhost:6379/0

# Etapa 1: Google Places API (New)
GOOGLE_PLACES_API_KEY

# Etapa 2: Google PageSpeed Insights API
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# Etapa 2: Meta Graph API (Instagram Business Discovery)
META_GRAPH_ACCESS_TOKEN=your_meta_access_token_here
META_INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Etapa 2: Instagram Fallback (RapidAPI / ScrapeCreators)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=instagram-data-api.p.rapidapi.com

# Etapa 3 & 4: Anthropic Claude API (Haiku 4.5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Etapa 5: Google Stitch API / SDK
GOOGLE_STITCH_API_KEY=your_google_stitch_api_key_here
GOOGLE_STITCH_BASE_URL=https://stitch.googleapis.com/v1
